# Build dependencies for the course website (source: docs/).
#
# Three gems, on purpose:
#   * jekyll                  — the site generator itself (same major version
#                               GitHub Pages uses; see pages.github.com/versions)
#   * kramdown-parser-gfm     — required by Jekyll 3.9 + kramdown 2.x for
#                               `input: GFM` in docs/_config.yml
#   * jekyll-relative-links   — converts the course's relative .md links to
#                               .html URLs on the built site
#
# If you ever want strict version parity with the Pages server, replace all
# three lines with:  gem "github-pages", group: :jekyll_plugins
source "https://rubygems.org"

gem "jekyll", "~> 3.9"
gem "kramdown-parser-gfm", "~> 1.1"
gem "jekyll-relative-links", "~> 0.7"
gem "jekyll-coffeescript"